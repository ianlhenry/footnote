{
  "name": "papertrail-llm",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:api": "tsx watch api/server.ts",
    "dev:web": "npm run dev --prefix web",
    "eval": "tsx evals/cli.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test api/*.test.ts evals/numbers.test.ts",
    "test:evals": "tsx --test evals/selftest.test.ts",
    "check": "biome check . && npm run typecheck && npm run test && npm run test:evals",
    "format": "biome check --write .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.16",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "sqlite-vec": "^0.1.9"
  }
}
